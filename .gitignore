# ── Dependencies / build ──────────────────────────────────
node_modules/
dist/
*.tsbuildinfo
# بستهٔ موقت انتقال فرانت به سرور (deploy.bat آن را می‌سازد و پاک می‌کند؛
# اگر اجرا نیمه‌کاره بماند، نباید با git add -A کامیت شود)
dist.tgz
site.tgz

# ── Deploy / tooling caches ───────────────────────────────
.vercel/
.qwen/
# کانفیگ شخصی اسکریپت دیپلوی (آدرس SSH سرور) — نباید وارد گیت شود
deploy-config.bat

# ── OS junk ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Environment secrets ───────────────────────────────────
# هیچ فایل env واقعی نباید کامیت شود؛ فقط نمونه مجاز است.
.env
.env.*
!.env.example

# ── Python backend (backend/) ─────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── فایل‌های آپلودی زمان‌اجرا (استوریج محلی فاز ۸) ──────
# عکس‌های کاربر نباید در گیت ذخیره شوند؛ روی سرور زیر storage_dir می‌مانند.
backend/var/
var/uploads/

# ── خروجی مهاجرت داده (فاز ۱۰) ──────────────────────────
# این پوشه دادهٔ واقعی خانواده است: هش رمز، شمارهٔ تلفن، شمارهٔ کارت.
# هرگز نباید کامیت شود — deploy.bat با `git add -A` جارو می‌کند.
backend/migration/export/

# ── پیش‌نمایش موقت لوگوها ────────────────────────────────
# خروجی بازبینی چشمی است، نه بخشی از اپ. Vite هم آن را نمی‌بیند
# (نقطه‌ی ورود فقط index.html است) ولی `git add -A` جاروش می‌کند.
logo-preview.html

# ── فایل نصب اندروید که کنار سایت آپلود می‌شود ───────────
# deploy.bat هنگام دیپلوی، APK ساخته‌شده را در site/ کپی می‌کند تا
# روی khaanehyar.ir/khanehyar.apk سرو شود. خودِ فایل باینری است و
# نباید در مخزن بماند؛ `git add -A` وگرنه جاروش می‌کند.
site/*.apk
