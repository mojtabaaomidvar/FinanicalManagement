[Unit]
Description=KhanehYar consistent scheduled backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/khaneyar-management/source/backend
ExecStart=/opt/khaneyar-management/venv/bin/python -m app.management.cli --config /etc/khaneyar-management/config.json backup
UMask=0077
TimeoutStartSec=3600
