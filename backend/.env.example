# نمونهٔ متغیرهای محیطی بک‌اند — این فایل قابل‌کامیت است.
# مقدار واقعی را در backend/.env بگذارید (که در .gitignore هست).

APP_ENV=development
DEBUG=true

# اتصال دیتابیس (درایور psycopg 3)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/khaneyar

# منشأهای مجاز CORS — با کاما جدا شوند (بدون *)
CORS_ORIGINS=http://localhost:5173

# نشست‌ها
SESSION_TOKEN_BYTES=32
SESSION_SLIDING_DAYS=7
SESSION_ABSOLUTE_DAYS=90

# OTP و ضد brute-force
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
BRUTE_FORCE_MAX_FAILS=10
BRUTE_FORCE_WINDOW_MINUTES=15

# ── سقفِ نرخِ per-IP روی مسیرهای عمومیِ احراز (§5.11) ──────────
# نمکِ HMAC برای کلیدِ ناشناسِ سطل. نشانیِ IP خام هرگز ذخیره نمی‌شود؛ فقط هشِ
# نمک‌خورده. «راز» است — با `openssl rand -hex 32` بسازید.
# اگر خالی بماند از FILE_SIGNING_SECRET استفاده می‌شود؛ اگر آن هم خالی باشد نمکِ
# تصادفیِ درون‌فرایندی می‌سازد که با هر ری‌استارت شمارنده را صفر می‌کند (هشدار لاگ).
RATE_LIMIT_SALT=
# کلیدِ امضای URLِ فایل‌ها — همین‌جا هست چون نمکِ پشتیبانِ بالا از آن می‌آید.
FILE_SIGNING_SECRET=
# فهرستِ صریحِ IPِ پروکسیِ مورد اعتماد (با کاما). خالی = هر peerِ loopback/خصوصی
# مورد اعتماد است؛ برای چیدمانِ «nginx روی هاست + کانتینرِ بسته به 127.0.0.1»
# درست است. اگر API را بی‌واسطه در معرضِ اینترنت گذاشتید، اینجا را صریح پر کنید.
TRUSTED_PROXY_IPS=
# پنجرهٔ همهٔ سقف‌های زیر (ثانیه) و سقفِ هر مسیر در آن پنجره. صفر = بی‌سقف.
RL_WINDOW_SECONDS=60
RL_LOGIN_PER_IP=30
RL_CHECK_PASSWORD_PER_IP=30
RL_PRE_REGISTERED_PER_IP=10
RL_JOIN_PER_IP=8
RL_REGISTER_PER_IP=5
RL_OTP_REQUEST_PER_IP=5
RL_PASSWORD_RESET_PER_IP=5

# پارامترهای Argon2id
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ── پیامکِ خروجی (کدِ یک‌بارمصرف و بازیابیِ رمز) ────────────────
# تا وقتی SMS_API_KEY خالی است، فرستنده «خنثی» است: هیچ پیامکی ارسال نمی‌شود،
# هیچ خطایی هم بالا نمی‌رود، و کدِ بازیابی هم در پاسخِ API برنمی‌گردد (رفع D-2).
# در حالتِ توسعه کد در لاگِ سرور دیده می‌شود؛ در تولید (APP_ENV=production) نه.
# فعال‌سازی فقط با پرکردنِ این کلیدها در backend/.env — هیچ کلیدی اینجا نوشته نشود.
SMS_PROVIDER=
# کاوه‌نگار کلید را در *مسیرِ URL* می‌گذارد، پس از همهٔ لاگ‌ها و خطاها scrub می‌شود.
SMS_API_KEY=
# خطِ ارسال — فقط برای پیامکِ متنِ آزاد (sms/send.json). با قالب لازم نیست.
SMS_SENDER=
# نامِ قالبِ «تأیید» در پنلِ کاوه‌نگار. پر باشد → مسیرِ verify/lookup.json که
# برای کدِ یک‌بارمصرف در ایران درست‌تر است: فیلتر نمی‌شود و خطِ اختصاصی نمی‌خواهد.
SMS_TEMPLATE=
SMS_TIMEOUT_SECONDS=6

# عمرِ کدِ بازیابیِ رمز (ثانیه). جدا از OTP_TTL_SECONDS چون کاربر باید پیامک را
# ببیند، برگردد، کد را بزند و رمزِ تازه را دو بار بنویسد.
PASSWORD_RESET_TTL_SECONDS=900

# بازار — قیمت طلا/ارز و شاخص بورس از BrsApi.ir
# کلید رایگان: https://brsapi.ir/tsetmc-exchange-free-bourse-api-key-request/
# ⚠️ کلیدی که تا ۲۰۲۶-۰۹-۲۷ در همین خط کامیت شده بود «سوخته» است (مخزن عمومی
# است و کلید در تاریخِ گیت می‌ماند). در پنلِ BrsApi باطل و از نو بسازید و مقدارِ
# تازه را فقط در backend/.env بگذارید — اینجا خالی بماند.
BRSAPI_KEY=
# عمر کش سرور-سمتی به ثانیه (پیش‌فرض ۳۰۰ — سقف پلن رایگان: ۱۵۰۰ درخواست/روز)
MARKET_CACHE_SECONDS=864

# ذخیره‌سازی آبجکت سازگار با S3 (آواتار/عکس تراکنش)
STORAGE_ENDPOINT=
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_PHOTOS=tx-photos
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
