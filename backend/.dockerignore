# ── چیزهایی که هرگز نباید داخلِ ایمیجِ Docker بروند ──

# اسرار (حیاتی): فایل‌های محیطی هرگز نباید در ایمیج باشند
.env
.env.*

# محیطِ مجازی و کش‌ها
.venv/
venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/

# دادهٔ محلیِ آپلود (روی دیسک/S3ِ تولید ساخته می‌شود، نه در ایمیج)
var/

# تست‌ها (در تولید لازم نیست)
tests/

# git و مستندات
.git/
.gitignore
*.md
