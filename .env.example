# تنظیمات اتصال به Supabase (Vite env)
# مقادیر را از: Supabase Dashboard → Settings → API بردارید
# این فایل را به ‎.env.local‎ کپی کرده و پر کنید
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── اجرای محلی npm run dev (پلاگین scripts/dev-api.ts) ──
# توابع api/*.js روی سرور dev اجرا می‌شوند و این متغیرها را از process.env می‌خوانند
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# اگر Supabase از این شبکه در دسترس نباشد (ایران بدون VPN) یا کلید service
# محلی تنظیم نباشد، /api/* به‌صورت خودکار به این نسخه‌ی دپلوی‌شده فوروارد می‌شود
DEV_API_FALLBACK=https://YOUR_PROJECT.vercel.app

# اختیاری — فقط برای اجرای محلی کامل send-otp / upload-* / sms-webhook
# (نبود آن اشکالی ندارد؛ این توابع به DEV_API_FALLBACK فوروارد می‌شوند)
# SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# اپ نیتیو (Capacitor): آدرس مطلق توابع سرورless برای WebView اندروید/iOS
# (در مرورگر خالی بماند — همان دامنه استفاده می‌شود)
VITE_API_BASE=https://YOUR_PROJECT.vercel.app
