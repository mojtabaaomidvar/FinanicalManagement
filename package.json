{
  "name": "mali-man",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run copy:studio:coverage",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-test-environment.ps1",
    "sandbox:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-test-environment.ps1 -Action Stop",
    "sandbox:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-test-environment.ps1 -Action Check",
    "sandbox:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-test-environment.ps1 -Action Refresh",
    "sandbox:offline-check": "node scripts/check-shopping-offline.mjs",
    "sandbox:tasks-check": "node scripts/check-tasks-offline.mjs",
    "sandbox:documents-check": "node scripts/check-documents.mjs",
    "sandbox:meals-check": "node scripts/check-meals.mjs",
    "sandbox:equipment-check": "node scripts/check-equipment.mjs",
    "sandbox:vehicles-check": "node scripts/check-vehicles.mjs",
    "sandbox:goals-check": "node scripts/check-goals.mjs",
    "sandbox:activities-check": "node scripts/check-activities.mjs",
    "sandbox:children-check": "node scripts/check-children.mjs",
    "sandbox:pets-check": "node scripts/check-pets.mjs",
    "sandbox:home-check": "node scripts/check-home.mjs",
    "sandbox:home-arrangement-check": "node scripts/check-home-arrangement.mjs",
    "copy:studio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-copy-workbench.ps1",
    "copy:studio:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-copy-workbench.ps1 -Action Stop",
    "copy:studio:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-copy-workbench.ps1 -Action Check",
    "copy:studio:test": "node --test scripts/copy-workbench/*.test.mjs",
    "copy:studio:coverage": "node scripts/check-copy-coverage.mjs",
    "copy:studio:finance-check": "node scripts/check-finance-refresh.mjs",
    "sandbox:calendar-check": "node scripts/check-calendar.mjs",
    "sandbox:profile-check": "node scripts/check-profile.mjs",
    "sandbox:birthday-calendar-check": "node scripts/check-birthday-calendar.mjs",
    "prototype:home": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview-home-prototype.ps1",
    "prototype:home:check": "node scripts/check-home-prototype.mjs",
    "prototype:home:drag-check": "node scripts/check-home-prototype-drag.mjs",
    "cap:sync": "npm run build && cap sync android",
    "cap:android": "cap open android",
    "copy:studio:inventory-check": "node scripts/check-inventory-refresh.mjs",
    "copy:studio:inventory-categories-check": "node scripts/check-inventory-categories.mjs",
    "copy:studio:assistant-check": "node scripts/check-household-assistant.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.2",
    "@web3icons/core": "^4.0.55",
    "cryptocurrency-icons": "^0.18.1",
    "esbuild": "^0.25.12",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.4"
  }
}
